# Copy this file to .env and fill in your own values. .env is gitignored.

# From your Yahoo Developer app (https://developer.yahoo.com/apps/) - a
# "Fantasy Sports - Read" app is enough, this module never writes.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Your league's Yahoo game key + league id, e.g. "428.l.123456" for an NBA
# league - found in the league's Yahoo URL.
YAHOO_LEAGUE_KEY=

# Your draft slot (1-indexed). Not reliably available via the API pre-draft
# (draft order can be randomized at draft time), so set it manually.
YAHOO_MY_DRAFT_SLOT=12

# Where yahoo_oauth caches the OAuth token after the first browser login.
# Keep this out of git (already covered by .gitignore's oauth2.json pattern).
YAHOO_OAUTH_TOKEN_FILE=oauth2.json
