# --- data_prep: Yahoo API credentials & tokens - never commit these ---
data_prep/.env
data_prep/*.env
data_prep/**/oauth2.json
data_prep/**/*token*.json
data_prep/**/__pycache__/
data_prep/.venv/

# --- Flutter app: Yahoo client id/secret for in-app login - never commit ---
/secrets.json

# --- Worker snapshot (lives on the `data` branch, not main) ---
/state/
